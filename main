local function makeActionBtn(parent, text, xScale, xOff, yPos, wScale, wOff, hPx, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(wScale, wOff, 0, hPx)
    b.Position = UDim2.new(xScale, xOff, 0, yPos)
    b.BackgroundColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.Text = text
    b.TextColor3 = Color3.fromRGB(10, 10, 16)
    b.TextSize = 11
    b.TextWrapped = true
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)

    local active = false
    local function setVisual(on)
        active = on
        b.BackgroundColor3 = on and Theme.Green or Color3.new(1, 1, 1)
    end

    b.MouseButton1Click:Connect(function()
        if callback then
            local nextState = not active
            local ret = callback(nextState, b)
            if type(ret) == "boolean" then
                setVisual(ret)
            elseif ret ~= "nottoggle" then
                setVisual(nextState)
            end
        end
    end)

    return b, setVisual
end

local State = {
    GhostEsp = false,
    ItemEsp = false,
    PlayersEsp = false,
    EvidenceEsp = false,
    Fullbright = false,
    SpeedEnabled = false,
    WalkSpeed = 20,
    AutoSpirit = false,
    PhotoCount = 0,
    LightsOn = true,
}

local function getHRP(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function findGhostModel()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(obj) then
            local lower = string.lower(obj.Name)
            if lower:find("ghost") or lower:find("demon") or lower:find("spirit") or lower:find("entity") or lower:find("phantom") or obj:GetAttribute("IsGhost") == true then
                return obj
            end
        end
    end
    return nil
end

local espFolders = {}
local function clearEsp(cat)
    for k, f in pairs(espFolders) do
        if not cat or k == cat then
            pcall(function() f:Destroy() end)
            espFolders[k] = nil
        end
    end
end

local function ensureEspFolder(cat)
    if not espFolders[cat] then
        local f = Instance.new("Folder")
        f.Name = "ZX_ESP_" .. cat
        f.Parent = EspGui
        espFolders[cat] = f
    end
    return espFolders[cat]
end

local function rebuildCategoryEsp(cat, predicate, colorFn, textFn)
    clearEsp(cat)
    local folder = ensureEspFolder(cat)
    local char = LocalPlayer.Character
    local myHrp = getHRP(char)

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if predicate(obj) then
            local part = obj:IsA("BasePart") and obj or getHRP(obj) or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
            if part and part.Parent and (not char or not part:IsDescendantOf(char)) then
                local dist = myHrp and math.floor((part.Position - myHrp.Position).Magnitude) or 0
                local col = colorFn(obj)
                local txt = textFn(obj, dist)

                local bb = Instance.new("BillboardGui")
                bb.Adornee = part
                bb.AlwaysOnTop = true
                bb.Size = UDim2.fromOffset(180, 28)
                bb.StudsOffset = Vector3.new(0, 2, 0)
                bb.Parent = folder

                local lbl = Instance.new("TextLabel", bb)
                lbl.Size = UDim2.fromScale(1, 1)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.GothamBold
                lbl.Text = txt
                lbl.TextColor3 = col
                lbl.TextStrokeTransparency = 0.25
                lbl.TextSize = 12

                local hl = Instance.new("Highlight")
                hl.Adornee = obj:IsA("Model") and obj or part
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.FillColor = col
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.FillTransparency = 0.55
                hl.Parent = folder
            end
        end
    end
end

makeActionBtn(Page1, "Ghost esp", 0, 0, 188, 0.23, -4, 30, function(on)
    State.GhostEsp = on
    if not on then clearEsp("ghost") end
    return on
end)

makeActionBtn(Page1, "Hunt escape", 0.25, 0, 188, 0.23, -4, 30, function(_, btn)
    local char = LocalPlayer.Character
    local hrp = getHRP(char)
    local ghost = findGhostModel()
    local gHrp = getHRP(ghost)
    if hrp and gHrp then
        local awayDir = (hrp.Position - gHrp.Position)
        awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
        if awayDir.Magnitude < 0.1 then awayDir = Vector3.new(0, 0, -1) else awayDir = awayDir.Unit end
        hrp.CFrame = CFrame.new(hrp.Position + awayDir * 45 + Vector3.new(0, 2, 0))
    elseif hrp then
        hrp.CFrame = hrp.CFrame + Vector3.new(0, 12, 0)
    end
    btn.BackgroundColor3 = Theme.Cyan
    task.delay(0.25, function() if btn.Parent then btn.BackgroundColor3 = Color3.new(1, 1, 1) end end)
    return "nottoggle"
end)

makeActionBtn(Page1, "Place stuffs near ghost", 0.5, 0, 188, 0.23, -4, 30, function(_, btn)
    local char = LocalPlayer.Character
    local hrp = getHRP(char)
    local ghost = findGhostModel()
    local gHrp = getHRP(ghost)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if hrp and gHrp and bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local n = string.lower(tool.Name)
                if n:find("emf") or n:find("book") or n:find("write") or n:find("projector") or n:find("dots") or n:find("therm") or n:find("spirit") then
                    tool.Parent = char
                    pcall(function()
                        if tool:FindFirstChild("Handle") then
                            tool.Handle.CFrame = gHrp.CFrame * CFrame.new(0, 0, -3)
                        end
                    end)
                end
            end
        end
    end
    btn.BackgroundColor3 = Theme.Cyan
    task.delay(0.25, function() if btn.Parent then btn.BackgroundColor3 = Color3.new(1, 1, 1) end end)
    return "nottoggle"
end)

makeActionBtn(Page1, "Check speed: 1s", 0.75, 0, 188, 0.25, 0, 30, function(_, btn)
    local ghost = findGhostModel()
    local gHrp = getHRP(ghost)
    if not gHrp then
        btn.Text = "No ghost"
        task.delay(1, function() if btn.Parent then btn.Text = "Check speed: 1s" end end)
        return "nottoggle"
    end
    local p1 = gHrp.Position
    task.wait(1)
    local p2 = gHrp.Position
    local spd = math.floor((p2 - p1).Magnitude * 10) / 10
    btn.Text = "Spd: " .. tostring(spd)
    task.delay(2, function() if btn.Parent then btn.Text = "Check speed: 1s" end end)
    return "nottoggle"
end)

makeActionBtn(Page1, "Turn on fuse", 0, 0, 226, 0.23, -4, 30, function(_, btn)
    local char = LocalPlayer.Character
    local hrp = getHRP(char)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local n = string.lower(obj.Name)
        if n:find("fuse") or n:find("breaker") or n:find("powerbox") then
            local prompt = obj:IsA("ProximityPrompt") and obj or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            local click = obj:IsA("ClickDetector") and obj or obj:FindFirstChildWhichIsA("ClickDetector", true)
            local targetPart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if hrp and targetPart then
                hrp.CFrame = targetPart.CFrame * CFrame.new(0, 0, 3)
            end
            if prompt and fireproximityprompt then pcall(fireproximityprompt, prompt) end
            if click and fireclickdetector then pcall(fireclickdetector, click) end
        end
    end
    btn.BackgroundColor3 = Theme.Cyan
    task.delay(0.25, function() if btn.Parent then btn.BackgroundColor3 = Color3.new(1, 1, 1) end end)
    return "nottoggle"
end)

makeActionBtn(Page1, "Auto spirit box", 0.25, 0, 226, 0.23, -4, 30, function(on)
    State.AutoSpirit = on
    return on
end)

makeActionBtn(Page1, "Take a photo ghost", 0.5, 0, 226, 0.23, -4, 30, function(_, btn)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if char and bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and (string.lower(t.Name):find("camera") or string.lower(t.Name):find("photo")) then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum:EquipTool(t) end
                task.wait(0.1)
                t:Activate()
            end
        end
    end
    btn.BackgroundColor3 = Theme.Cyan
    task.delay(0.25, function() if btn.Parent then btn.BackgroundColor3 = Color3.new(1, 1, 1) end end)
    return "nottoggle"
end)

makeActionBtn(Page1, "Toggle all lights", 0.75, 0, 226, 0.25, 0, 30, function(on)
    State.LightsOn = not on
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            pcall(function() obj.Enabled = State.LightsOn end)
        elseif obj:IsA("ClickDetector") and string.lower(obj.Parent.Name):find("light") then
            if fireclickdetector then pcall(fireclickdetector, obj) end
        elseif obj:IsA("ProximityPrompt") and string.lower(obj.Parent.Name):find("light") then
            if fireproximityprompt then pcall(fireproximityprompt, obj) end
        end
    end
    return on
end)

