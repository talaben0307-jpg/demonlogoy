local function makeActionBtn(parent, text, xScale, xOff, yPos, wScale, wOff, hPx, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(wScale, wOff, 0, hPx)
    b.Position = UDim2.new(xScale, xOff, 0, yPos)
    b.BackgroundColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.Text = text
    b.TextColor3 = Color3.fromRGB(10, 10, 16)
    b.TextSize = 11
    b.TextWrapped = true
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)

    local active = false
    local function setVisual(on)
        active = on
        b.BackgroundColor3 = on and Theme.Green or Color3.new(1, 1, 1)
    end

    b.MouseButton1Click:Connect(function()
        if callback then
            local nextState = not active
            local ret = callback(nextState, b)
            if type(ret) == "boolean" then
                setVisual(ret)
            elseif ret ~= "nottoggle" then
                setVisual(nextState)
            end
        end
    end)

    return b, setVisual
end

local State = {
    GhostEsp = false,
    ItemEsp = false,
    PlayersEsp = false,
    EvidenceEsp = false,
    Fullbright = false,
    SpeedEnabled = false,
    WalkSpeed = 20,
    AutoSpirit = false,
    PhotoCount = 0,
    LightsOn = true,
}

local function getHRP(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function isPlayerOrCharacter(inst)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and (inst == plr.Character or inst:IsDescendantOf(plr.Character)) then
            return true
        end
    end
    return false
end

local function isMapStructure(inst)
    if not inst or not inst.Parent then return true end
    if inst == Workspace or inst == Workspace.CurrentCamera then return true end
    if inst:IsDescendantOf(MainGui) or inst:IsDescendantOf(EspGui) then return true end
    local p = inst.Parent
    while p and p ~= Workspace do
        local pn = string.lower(p.Name)
        if pn == "map" or pn == "maps" or pn == "house" or pn == "building" or pn == "buildings"
            or pn == "rooms" or pn == "walls" or pn == "floors" or pn == "terrain" or pn == "lighting"
            or pn == "props" or pn == "furniture" or pn == "exterior" or pn == "interior" or pn == "yard"
            or pn == "street" or pn == "road" or pn == "trees" or pn == "foliage" or pn == "spawns" then
            return true
        end
        p = p.Parent
    end
    local n = string.lower(inst.Name)
    local envNames = {
        "wall", "floor", "ceiling", "roof", "door", "window", "stairs", "stair",
        "fence", "gate", "tree", "bush", "grass", "leaf", "leaves", "rock", "stone",
        "dirt", "sand", "water", "road", "sidewalk", "curb", "car", "truck", "van",
        "lamp", "streetlight", "post", "pole", "table", "chair", "bed", "sofa", "couch",
        "cabinet", "shelf", "sink", "toilet", "shower", "bath", "fridge", "stove",
        "tv_screen", "screen", "painting", "picture", "frame", "curtain", "blind",
        "baseplate", "spawnlocation", "part", "union", "meshpart", "wedgepart", "cornerwedgepart"
    }
    for _, en in ipairs(envNames) do
        if n == en or n:find("^" .. en .. "[%d_]") or n:find("_" .. en .. "$") then
            return true
        end
    end
    return false
end

local function isActiveVisualVisible(inst)
    if not inst then return false end
    if inst:IsA("BasePart") then
        if inst.Transparency >= 0.98 then return false end
        local parentModel = inst:FindFirstAncestorOfClass("Model")
        if parentModel and parentModel ~= inst and not getHRP(parentModel) then
            local hasVisible = false
            for _, d in ipairs(parentModel:GetDescendants()) do
                if d:IsA("BasePart") and d.Transparency < 0.98 then
                    hasVisible = true
                    break
                end
            end
            if not hasVisible then return false end
        end
        return true
    elseif inst:IsA("Model") then
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("BasePart") and d.Transparency < 0.98 then
                return true
            end
        end
        return false
    elseif inst:IsA("Tool") then
        return true
    end
    return false
end

local function findGhostModel()
    local candidates = {}
    for _, folderName in ipairs({ "Ghost", "Ghosts", "Entity", "Entities", "Monster", "Monsters", "AI", "NPCs" }) do
        local f = Workspace:FindFirstChild(folderName)
        if f then
            for _, obj in ipairs(f:GetDescendants()) do
                if obj:IsA("Model") and not isPlayerOrCharacter(obj) and getHRP(obj) then
                    table.insert(candidates, obj)
                end
            end
        end
    end
    if #candidates > 0 then return candidates[1] end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and not isPlayerOrCharacter(obj) then
            local n = string.lower(obj.Name)
            local hasGhostAttr = obj:GetAttribute("GhostType") ~= nil
                or obj:GetAttribute("IsGhost") == true
                or obj:GetAttribute("Ghost") == true
                or obj:GetAttribute("FavoriteRoom") ~= nil
                or obj:GetAttribute("GhostRoom") ~= nil
                or obj:GetAttribute("CurrentRoom") ~= nil
            if hasGhostAttr or n:find("ghost") or n:find("demon") or n:find("spirit") or n:find("entity") or n:find("phantom") or n:find("wraith") or n:find("banshee") or n:find("shade") then
                if getHRP(obj) then
                    return obj
                end
            end
        end
    end
    return nil
end

local function isRealGhostOrb(obj)
    if isPlayerOrCharacter(obj) or isMapStructure(obj) then return false end
    local n = string.lower(obj.Name)
    if not (n:find("orb") or n:find("ghostorb")) then return false end
    if n:find("absorb") or n:find("effect") or n:find("trail") then return false end

    if obj:IsA("ParticleEmitter") then
        return obj.Enabled == true and obj.Rate > 0
    end
    if obj:IsA("BasePart") then
        if obj.Transparency >= 0.95 then return false end
        local pe = obj:FindFirstChildWhichIsA("ParticleEmitter", true)
        if pe then
            return pe.Enabled == true
        end
        return true
    end
    if obj:IsA("Model") then
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ParticleEmitter") and d.Enabled == true then
                return true
            elseif d:IsA("BasePart") and d.Transparency < 0.95 then
                return true
            end
        end
        return false
    end
    return false
end

local function isRealHandprints(obj)
    if isPlayerOrCharacter(obj) or isMapStructure(obj) then return false end
    local n = string.lower(obj.Name)
    if not (n:find("handprint") or n:find("fingerprint") or n:find("hand_print") or n:find("finger_print")) then
        return false
    end
    if obj:IsA("Decal") or obj:IsA("Texture") then
        return obj.Transparency < 0.95
    end
    if obj:IsA("BasePart") then
        if obj.Transparency < 0.95 then return true end
        for _, d in ipairs(obj:GetDescendants()) do
            if (d:IsA("Decal") or d:IsA("Texture")) and d.Transparency < 0.95 then
                return true
            end
        end
        return false
    end
    if obj:IsA("Model") then
        for _, d in ipairs(obj:GetDescendants()) do
            if (d:IsA("Decal") or d:IsA("Texture")) and d.Transparency < 0.95 then
                return true
            elseif d:IsA("BasePart") and d.Transparency < 0.95 then
                return true
            end
        end
        return false
    end
    return false
end

local function isRealSpiritBox(obj)
    if isPlayerOrCharacter(obj) then return false end
    local n = string.lower(obj.Name)
    if n:find("spiritbox") or n:find("spirit_box") or n:find("spirit box") then
        if obj:GetAttribute("Response") == true or obj:GetAttribute("Answered") == true or obj:GetAttribute("Triggered") == true then
            return true
        end
        for _, d in ipairs(obj:GetDescendants()) do
            if (d:IsA("BoolValue") or d:IsA("StringValue")) and (string.lower(d.Name):find("response") or string.lower(d.Name):find("speak") or string.lower(d.Name):find("reply")) then
                if (d:IsA("BoolValue") and d.Value == true) or (d:IsA("StringValue") and d.Value ~= "") then
                    return true
                end
            elseif d:IsA("Sound") and d.IsPlaying then
                return true
            end
        end
    end
    return false
end

local function isRealWriting(obj)
    if isPlayerOrCharacter(obj) or isMapStructure(obj) then return false end
    local n = string.lower(obj.Name)
    if n:find("writing") or n:find("ghostbook") or n:find("written") or n:find("journal") then
        if obj:GetAttribute("Written") == true or obj:GetAttribute("HasWriting") == true then
            return true
        end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("Decal") or d:IsA("Texture") then
                local dn = string.lower(d.Name)
                if (dn:find("write") or dn:find("written") or dn:find("draw") or dn:find("mark") or dn:find("page")) and d.Transparency < 0.95 then
                    return true
                end
            elseif d:IsA("BoolValue") and string.lower(d.Name):find("writ") and d.Value == true then
                return true
            end
        end
        if n:find("written") then
            return isActiveVisualVisible(obj)
        end
    end
    return false
end

local function isRealLaserProjector(obj)
    if isPlayerOrCharacter(obj) or isMapStructure(obj) then return false end
    local n = string.lower(obj.Name)
    if n:find("laser") or n:find("projector") or n:find("dots") then
        if obj:GetAttribute("Detected") == true or obj:GetAttribute("GhostSeen") == true or obj:GetAttribute("Triggered") == true then
            return true
        end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("BoolValue") and (string.lower(d.Name):find("detect") or string.lower(d.Name):find("seen") or string.lower(d.Name):find("ghost")) and d.Value == true then
                return true
            end
        end
    end
    return false
end

local function isRealWither(obj)
    if isPlayerOrCharacter(obj) or isMapStructure(obj) then return false end
    local n = string.lower(obj.Name)
    if n:find("wither") or n:find("withered") or n:find("wilted") then
        if obj:GetAttribute("Withered") == true or obj:GetAttribute("IsWithered") == true then
            return true
        end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("BoolValue") and string.lower(d.Name):find("wither") and d.Value == true then
                return true
            end
        end
        if n:find("withered") or n:find("wilted") then
            return isActiveVisualVisible(obj)
        end
        if obj:IsA("BasePart") and obj.Transparency < 0.95 then
            local col = obj.Color
            if col.R < 0.35 and col.G < 0.35 and col.B < 0.35 then
                return true
            end
        end
    end
    return false
end

local function readGameData()
    local data = {
        handprints = false,
        spirit = false,
        orb = false,
        writing = false,
        laser = false,
        wither = false,
        emf = 0,
        temp = nil,
        ghostType = "None",
        gender = "None",
        age = "None",
        favRoom = "None",
        curRoom = "None",
        difficulty = nil,
    }

    local sources = {}
    local ghost = findGhostModel()
    if ghost then table.insert(sources, ghost) end

    for _, folderName in ipairs({ "GhostData", "GameData", "MatchData", "RoomData", "Evidence", "Evidences", "Round", "GameState" }) do
        local f = Workspace:FindFirstChild(folderName) or ReplicatedStorage:FindFirstChild(folderName)
        if f then table.insert(sources, f) end
    end

    for _, s in ipairs(sources) do
        local attrs = s:GetAttributes()
        for k, v in pairs(attrs) do
            local lk = string.lower(k)
            if lk:find("handprint") or lk:find("fingerprint") then
                if v == true then data.handprints = true end
            elseif lk:find("spirit") then
                if v == true then data.spirit = true end
            elseif lk:find("orb") then
                if v == true then data.orb = true end
            elseif lk:find("writing") or lk:find("book") then
                if v == true then data.writing = true end
            elseif lk:find("laser") or lk:find("projector") or lk:find("dots") then
                if v == true then data.laser = true end
            elseif lk:find("wither") then
                if v == true then data.wither = true end
            elseif lk == "emf" or lk:find("emflevel") then
                if type(v) == "number" then data.emf = math.max(data.emf, v) end
            elseif lk == "temperature" or lk == "temp" or lk:find("roomtemp") then
                if type(v) == "number" then data.temp = v end
            elseif lk:find("ghosttype") or lk == "type" or lk == "ghost" then
                if type(v) == "string" and v ~= "" then data.ghostType = v end
            elseif lk == "gender" or lk == "sex" then
                if type(v) == "string" and v ~= "" then data.gender = v end
            elseif lk == "age" then
                if v ~= nil and tostring(v) ~= "" then data.age = tostring(v) end
            elseif lk:find("favorite") or lk:find("favroom") or lk:find("ghostroom") then
                if type(v) == "string" and v ~= "" then data.favRoom = v end
            elseif lk:find("currentroom") or lk == "room" then
                if type(v) == "string" and v ~= "" then data.curRoom = v end
            elseif lk:find("difficult") or lk == "mode" then
                if type(v) == "string" and v ~= "" then data.difficulty = v end
            end
        end

        for _, desc in ipairs(s:GetDescendants()) do
            if desc:IsA("ValueBase") then
                local ln = string.lower(desc.Name)
                local val = desc.Value
                if ln:find("handprint") or ln:find("fingerprint") then
                    if val == true then data.handprints = true end
                elseif ln:find("spirit") then
                    if val == true then data.spirit = true end
                elseif ln:find("orb") then
                    if val == true then data.orb = true end
                elseif ln:find("writing") or ln:find("book") then
                    if val == true then data.writing = true end
                elseif ln:find("laser") or ln:find("projector") or ln:find("dots") then
                    if val == true then data.laser = true end
                elseif ln:find("wither") then
                    if val == true then data.wither = true end
                elseif ln == "emf" or ln:find("emflevel") then
                    if type(val) == "number" then data.emf = math.max(data.emf, val) end
                elseif ln == "temperature" or ln == "temp" then
                    if type(val) == "number" then data.temp = val end
                elseif ln:find("ghosttype") or ln == "type" then
                    if type(val) == "string" and val ~= "" then data.ghostType = val end
                elseif ln == "gender" then
                    if type(val) == "string" and val ~= "" then data.gender = val end
                elseif ln == "age" then
                    if tostring(val) ~= "" then data.age = tostring(val) end
                elseif ln:find("favorite") or ln:find("favroom") or ln:find("ghostroom") then
                    if type(val) == "string" and val ~= "" then data.favRoom = val end
                elseif ln:find("currentroom") or ln == "room" then
                    if type(val) == "string" and val ~= "" then data.curRoom = val end
                elseif ln:find("difficult") then
                    if type(val) == "string" and val ~= "" then data.difficulty = val end
                end
            end
        end
    end

    for _, valObj in ipairs(ReplicatedStorage:GetDescendants()) do
        if valObj:IsA("ValueBase") then
            local ln = string.lower(valObj.Name)
            if (ln:find("difficult") or ln == "gamemode") and type(valObj.Value) == "string" and valObj.Value ~= "" then
                data.difficulty = valObj.Value
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isRealHandprints(obj) then
            data.handprints = true
        end
        if isRealSpiritBox(obj) then
            data.spirit = true
        end
        if isRealGhostOrb(obj) then
            data.orb = true
        end
        if isRealWriting(obj) then
            data.writing = true
        end
        if isRealLaserProjector(obj) then
            data.laser = true
        end
        if isRealWither(obj) then
            data.wither = true
        end
        if not isMapStructure(obj) and string.lower(obj.Name):find("emf") then
            local lvl = tonumber(obj.Name:match("%d+")) or obj:GetAttribute("EMF") or 0
            if type(lvl) == "number" and lvl > data.emf then
                data.emf = math.clamp(lvl, 0, 5)
            end
        end
    end

    return data
end

local espFolders = {}
local function clearEsp(cat)
    for k, f in pairs(espFolders) do
        if not cat or k == cat then
            pcall(function() f:Destroy() end)
            espFolders[k] = nil
        end
    end
end

local function ensureEspFolder(cat)
    if not espFolders[cat] then
        local f = Instance.new("Folder")
        f.Name = "ZX_ESP_" .. cat
        f.Parent = EspGui
        espFolders[cat] = f
    end
    return espFolders[cat]
end

local function isPickupItem(obj)
    if isPlayerOrCharacter(obj) or isMapStructure(obj) then return false end
    if not (obj:IsA("Tool") or obj:IsA("Model") or obj:IsA("BasePart")) then return false end

    if obj:IsA("BasePart") then
        local parentModel = obj:FindFirstAncestorOfClass("Model")
        if parentModel and isPickupItem(parentModel) then
            return false
        end
    end

    if obj:IsA("Tool") then
        return true
    end

    local n = string.lower(obj.Name)
    local itemKeywords = {
        "flashlight", "camera", "therm", "emf", "book", "writing", "spirit", "box",
        "lighter", "crucifix", "salt", "projector", "dots", "uv", "candle", "smudge",
        "incense", "tripod", "sanity", "key", "fuse", "breaker", "sensor", "motion",
        "sound", "parabolic", "video", "battery", "pill", "pills", "cursed", "ouija",
        "tarot", "mirror", "doll", "musicbox", "voodoo", "bone"
    }
    for _, kw in ipairs(itemKeywords) do
        if n:find(kw, 1, true) then
            return isActiveVisualVisible(obj)
        end
    end

    if obj:FindFirstChildWhichIsA("ProximityPrompt", true) or obj:FindFirstChildWhichIsA("ClickDetector", true) then
        if not n:find("door") and not n:find("light") and not n:find("switch") and not n:find("button") then
            return isActiveVisualVisible(obj)
        end
    end

    return false
end

local function rebuildCategoryEsp(cat, predicate, colorFn, textFn)
    clearEsp(cat)
    local folder = ensureEspFolder(cat)
    local char = LocalPlayer.Character
    local myHrp = getHRP(char)
    local seen = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if predicate(obj) then
            local part = obj:IsA("BasePart") and obj
                or getHRP(obj)
                or obj:FindFirstChild("Handle")
                or obj:FindFirstChildWhichIsA("BasePart", true)
            if part and part.Parent and not seen[part] and (not char or not part:IsDescendantOf(char)) then
                seen[part] = true
                local dist = myHrp and math.floor((part.Position - myHrp.Position).Magnitude) or 0
                local col = colorFn(obj)
                local txt = textFn(obj, dist)

                local bb = Instance.new("BillboardGui")
                bb.Adornee = part
                bb.AlwaysOnTop = true
                bb.Size = UDim2.fromOffset(185, 28)
                bb.StudsOffset = Vector3.new(0, 2, 0)
                bb.Parent = folder

                local lbl = Instance.new("TextLabel", bb)
                lbl.Size = UDim2.fromScale(1, 1)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.GothamBold
                lbl.Text = txt
                lbl.TextColor3 = col
                lbl.TextStrokeTransparency = 0.25
                lbl.TextSize = 12

                local hl = Instance.new("Highlight")
                hl.Adornee = obj:IsA("Model") and obj or part
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.FillColor = col
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.FillTransparency = 0.55
                hl.Parent = folder
            end
        end
    end
end

