local tabs = {}
local function selectTab(tab)
    for _, t in ipairs(tabs) do
        local active = (t == tab)
        t.Active = active
        t.Page.Visible = active
        tween(t.Button, 0.15, {
            BackgroundColor3 = active and Theme.AccentDim or Theme.Element,
            BackgroundTransparency = active and 0.25 or 1,
            TextColor3 = active and Theme.Accent or Theme.SubText,
        })
    end
end

local function addTab(name, icon)
    local btn = create("TextButton", {
        Parent = Sidebar,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Font = Enum.Font.GothamSemibold,
        Text = icon .. "  " .. name,
        TextSize = 12,
        TextColor3 = Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, { corner(8), create("UIPadding", { PaddingLeft = UDim.new(0, 12) }) })

    local page = create("ScrollingFrame", {
        Parent = Content,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
    }, {
        create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 7) }),
        create("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }),
    })

    local tab = { Button = btn, Page = page, Active = false }
    table.insert(tabs, tab)
    btn.MouseButton1Click:Connect(function() selectTab(tab) end)
    if #tabs == 1 then selectTab(tab) end

    local api = {}

    function api:Section(text)
        local row = create("Frame", {
            Parent = page,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 22),
        })
        create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Font = Enum.Font.GothamBold,
            Text = "◆ " .. string.upper(text),
            TextSize = 11,
            TextColor3 = Theme.Accent,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
    end

    function api:InfoCard(title, bodyText)
        local f = create("Frame", {
            Parent = page,
            Size = UDim2.new(1, 0, 0, 44),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Theme.Element,
            BackgroundTransparency = 0.2,
        }, {
            corner(8),
            stroke(Theme.Accent, 1, 0.55),
            create("UIPadding", {
                PaddingTop = UDim.new(0, 8),
                PaddingBottom = UDim.new(0, 8),
                PaddingLeft = UDim.new(0, 12),
                PaddingRight = UDim.new(0, 12),
            }),
            create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
        })

        local tLbl = create("TextLabel", {
            Parent = f,
            LayoutOrder = 1,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 16),
            Font = Enum.Font.GothamBold,
            Text = title,
            TextSize = 12,
            TextColor3 = Theme.Accent,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local bLbl = create("TextLabel", {
            Parent = f,
            LayoutOrder = 2,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Enum.Font.Gotham,
            Text = bodyText,
            TextSize = 11,
            TextWrapped = true,
            TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        return {
            SetTitle = function(t) tLbl.Text = t end,
            SetBody = function(b) bLbl.Text = b end,
        }
    end

    function api:Toggle(text, default, callback)
        local f = create("Frame", {
            Parent = page,
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = Theme.Element,
            BackgroundTransparency = 0.25,
        }, { corner(8), stroke(Theme.Stroke, 1, 0.3) })

        create("TextLabel", {
            Parent = f,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 0),
            Size = UDim2.new(1, -64, 1, 0),
            Font = Enum.Font.Gotham,
            Text = text,
            TextSize = 12,
            TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local pill = create("Frame", {
            Parent = f,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.new(0, 38, 0, 20),
            BackgroundColor3 = Theme.Off,
        }, { corner(10) })

        local knob = create("Frame", {
            Parent = pill,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.new(0, 14, 0, 14),
            BackgroundColor3 = Theme.Text,
        }, { corner(10) })

        local hit = create("TextButton", {
            Parent = f,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
        })

        local state = default or false
        local function update(v)
            state = v
            tween(pill, 0.15, { BackgroundColor3 = state and Theme.Accent or Theme.Off })
            tween(knob, 0.15, { Position = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
            if callback then task.spawn(pcall, callback, state) end
        end

        hit.MouseButton1Click:Connect(function() update(not state) end)
        if state then update(true) end
        return { Get = function() return state end, Set = update }
    end

    function api:Slider(text, min, max, default, suffix, callback)
        local f = create("Frame", {
            Parent = page,
            Size = UDim2.new(1, 0, 0, 48),
            BackgroundColor3 = Theme.Element,
            BackgroundTransparency = 0.25,
        }, { corner(8), stroke(Theme.Stroke, 1, 0.3) })

        create("TextLabel", {
            Parent = f,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 4),
            Size = UDim2.new(1, -90, 0, 18),
            Font = Enum.Font.Gotham,
            Text = text,
            TextSize = 12,
            TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local valLbl = create("TextLabel", {
            Parent = f,
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -12, 0, 4),
            Size = UDim2.new(0, 75, 0, 18),
            Font = Enum.Font.GothamBold,
            Text = tostring(default) .. (suffix or ""),
            TextSize = 11,
            TextColor3 = Theme.Accent,
            TextXAlignment = Enum.TextXAlignment.Right,
        })

        local bar = create("Frame", {
            Parent = f,
            Position = UDim2.new(0, 12, 0, 30),
            Size = UDim2.new(1, -24, 0, 6),
            BackgroundColor3 = Theme.Off,
        }, { corner(6) })

        local fill = create("Frame", {
            Parent = bar,
            Size = UDim2.new(math.clamp((default - min) / (max - min), 0, 1), 0, 1, 0),
            BackgroundColor3 = Theme.Accent,
        }, { corner(6) })

        local hit = create("TextButton", {
            Parent = f,
            Position = UDim2.new(0, 8, 0, 20),
            Size = UDim2.new(1, -16, 0, 24),
            BackgroundTransparency = 1,
            Text = "",
        })

        local sliding = false
        local function setVal(x)
            local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
            local val = math.floor(min + (max - min) * rel + 0.5)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            valLbl.Text = tostring(val) .. (suffix or "")
            if callback then task.spawn(pcall, callback, val) end
        end

        hit.InputBegan:Connect(function(input)
            if isPress(input) then
                sliding = true
                setVal(input.Position.X)
            end
        end)
        track(UserInputService.InputChanged:Connect(function(input)
            if sliding and isMove(input) then setVal(input.Position.X) end
        end))
        track(UserInputService.InputEnded:Connect(function(input)
            if isPress(input) then sliding = false end
        end))
    end

    function api:Button(text, callback)
        local b = create("TextButton", {
            Parent = page,
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Theme.Element,
            BackgroundTransparency = 0.25,
            Font = Enum.Font.GothamSemibold,
            Text = text,
            TextSize = 12,
            TextColor3 = Theme.Accent,
            AutoButtonColor = false,
        }, { corner(8), stroke(Theme.Accent, 1, 0.5) })
        b.MouseEnter:Connect(function() tween(b, 0.15, { BackgroundColor3 = Theme.ElementHover }) end)
        b.MouseLeave:Connect(function() tween(b, 0.15, { BackgroundColor3 = Theme.Element }) end)
        b.MouseButton1Click:Connect(function()
            if callback then task.spawn(pcall, callback) end
        end)
        return b
    end

    return api
end

local Config = {
    GhostEsp = true,
    EvidenceEsp = true,
    CursedEsp = true,
    BreakerEsp = true,
    Fullbright = false,
    InfStamina = true,
    WalkSpeedEnabled = false,
    WalkSpeed = 24,
    NoClip = false,
}

local function getHRP(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function isGhostEntity(obj)
    if not obj:IsA("Model") or obj == LocalPlayer.Character or Players:GetPlayerFromCharacter(obj) then
        return false
    end
    local lower = string.lower(obj.Name)
    if lower:find("ghost") or lower:find("demon") or lower:find("spirit") or lower:find("entity") or lower:find("phantom") or lower:find("wraith") or lower:find("banshee") or lower:find("shade") then
        return true
    end
    if obj:GetAttribute("IsGhost") == true or obj:GetAttribute("Ghost") == true then
        return true
    end
    return false
end

local function classifyWorldObject(obj)
    local lower = string.lower(obj.Name)
    if lower:find("breaker") or lower:find("fuse") or lower:find("powerbox") or lower:find("generator") then
        return "breaker", "⚡ Breaker / Power"
    end
    if lower:find("ouija") or lower:find("tarot") or lower:find("cursed") or lower:find("mirror") or lower:find("doll") or lower:find("music box") or lower:find("voodoo") or lower:find("summon") then
        return "cursed", "🔮 Cursed: " .. obj.Name
    end
    if lower:find("orb") or lower:find("fingerprint") or lower:find("handprint") or lower:find("freezing") or lower:find("emf") or lower:find("evidence") or lower:find("bone") or lower:find("footprint") then
        return "evidence", "🔍 Evidence: " .. obj.Name
    end
    return nil, nil
end

local espPool = {}
local function clearEspByCategory(cat)
    for key, entry in pairs(espPool) do
        if not cat or entry.Category == cat then
            pcall(function() entry.Folder:Destroy() end)
            espPool[key] = nil
        end
    end
end

local function syncEspVisual(key, adornee, category, text, color, isModel)
    local char = LocalPlayer.Character
    local hrp = getHRP(char)
    local dist = (hrp and adornee:IsA("BasePart")) and math.floor((adornee.Position - hrp.Position).Magnitude) or 0

    local entry = espPool[key]
    if not entry or not entry.Folder.Parent then
        local folder = Instance.new("Folder")
        folder.Name = "DemoESP_" .. category
        folder.Parent = EspGui

        local bb = Instance.new("BillboardGui")
        bb.Adornee = adornee
        bb.AlwaysOnTop = true
        bb.Size = UDim2.fromOffset(200, 32)
        bb.StudsOffset = Vector3.new(0, 2.2, 0)
        bb.Parent = folder

        local lbl = Instance.new("TextLabel", bb)
        lbl.Name = "Tag"
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.TextStrokeTransparency = 0.25
        lbl.TextSize = 12
        lbl.Parent = bb

        local hl = Instance.new("Highlight")
        hl.Adornee = isModel and adornee.Parent or adornee
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.55
        hl.OutlineTransparency = 0
        hl.Parent = folder

        entry = { Folder = folder, Label = lbl, Highlight = hl, Category = category }
        espPool[key] = entry
    end

    entry.Label.Text = dist > 0 and string.format("%s [%dm]", text, dist) or text
    entry.Label.TextColor3 = color
    entry.Highlight.FillColor = color
    entry.Highlight.OutlineColor = Color3.new(1, 1, 1)
end

task.spawn(function()
    while env.ZenxhubDemonologyCleanup do
        if not Config.GhostEsp then clearEspByCategory("ghost") end
        if not Config.EvidenceEsp then clearEspByCategory("evidence") end
        if not Config.CursedEsp then clearEspByCategory("cursed") end
        if not Config.BreakerEsp then clearEspByCategory("breaker") end

        local seenKeys = {}

        if Config.GhostEsp then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if isGhostEntity(obj) then
                    local part = getHRP(obj)
                    if part and part.Parent then
                        local key = obj:GetDebugId()
                        seenKeys[key] = true
                        local hunting = (obj:GetAttribute("Hunting") == true) or (obj:GetAttribute("IsHunting") == true)
                        local tag = hunting and ("💀 HUNTING: " .. obj.Name) or ("👻 Ghost: " .. obj.Name)
                        local col = hunting and Theme.Danger or Theme.Accent2
                        syncEspVisual(key, part, "ghost", tag, col, true)
                    end
                end
            end
        end

        if Config.EvidenceEsp or Config.CursedEsp or Config.BreakerEsp then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Tool") then
                    local cat, label = classifyWorldObject(obj)
                    if cat then
                        local enabled = (cat == "evidence" and Config.EvidenceEsp)
                            or (cat == "cursed" and Config.CursedEsp)
                            or (cat == "breaker" and Config.BreakerEsp)
                        if enabled then
                            local part = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
                            if part and part.Parent then
                                local key = obj:GetDebugId()
                                seenKeys[key] = true
                                local col = (cat == "breaker" and Theme.Good)
                                    or (cat == "cursed" and Theme.Accent2)
                                    or Theme.Warn
                                syncEspVisual(key, part, cat, label, col, obj:IsA("Model"))
                            end
                        end
                    end
                end
            end
        end

        for key, entry in pairs(espPool) do
            if not seenKeys[key] then
                pcall(function() entry.Folder:Destroy() end)
                espPool[key] = nil
            end
        end

        task.wait(0.6)
    end
end)

local origAmbient = Lighting.Ambient
local origBrightness = Lighting.Brightness
local origGlobalShadows = Lighting.GlobalShadows
local origFogEnd = Lighting.FogEnd

track(RunService.Heartbeat:Connect(function()
    if Config.Fullbright then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 2.2
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and Config.WalkSpeedEnabled then
        hum.WalkSpeed = Config.WalkSpeed
    end

    if Config.InfStamina and char then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local n = string.lower(v.Name)
                if n:find("stamina") or n:find("energy") or n:find("sprint") then
                    if v.Name:lower():find("max") then
                        -- giữ nguyên max
                    elseif v.Value < 100 then
                        v.Value = 100
                    end
                end
            end
        end
        for attr, val in pairs(LocalPlayer:GetAttributes()) do
            local n = string.lower(attr)
            if (n:find("stamina") or n:find("energy")) and type(val) == "number" and val < 100 then
                LocalPlayer:SetAttribute(attr, 100)
            end
        end
    end
end))

track(RunService.Stepped:Connect(function()
    if Config.NoClip and LocalPlayer.Character then
        for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end
end))

onCleanup(function()
    Lighting.Ambient = origAmbient
    Lighting.Brightness = origBrightness
    Lighting.GlobalShadows = origGlobalShadows
    Lighting.FogEnd = origFogEnd
end)

