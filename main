local pageIndex = 1
NextPageBtn.MouseButton1Click:Connect(function()
    if pageIndex == 1 then
        pageIndex = 2
        Page1.Visible = false
        Page2.Visible = true
        NextPageBtn.Text = "Previous page"
    else
        pageIndex = 1
        Page2.Visible = false
        Page1.Visible = true
        NextPageBtn.Text = "Next page"
    end
end)

local minimized = false
MinBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    BodyHolder.Visible = not minimized
    BottomBar.Visible = not minimized
    MainFrame.Size = minimized and UDim2.fromOffset(470, 36) or UDim2.fromOffset(470, 385)
end)

CopyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        pcall(setclipboard, "https://raw.githubusercontent.com/talaben0307-jpg/lineageeee/refs/heads/main/main")
    end
    CopyBtn.BackgroundColor3 = Theme.Green
    task.delay(0.25, function() if CopyBtn.Parent then CopyBtn.BackgroundColor3 = Theme.Btn end end)
end)

track(UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.Z then
        MainGui.Enabled = not MainGui.Enabled
    end
end))

local dragging, dragStart, startPos = false, nil, nil
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
track(UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

env.ZenxhubDemonologyCleanup = function()
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    for _, fn in ipairs(cleanups) do
        pcall(fn)
    end
    table.clear(cleanups)
    clearEsp()
    pcall(function() MainGui:Destroy() end)
    pcall(function() EspGui:Destroy() end)
    env.ZenxhubDemonologyCleanup = nil
end

CloseBtn.MouseButton1Click:Connect(function()
    if env.ZenxhubDemonologyCleanup then env.ZenxhubDemonologyCleanup() end
end)

onCleanup(function()
    Lighting.Ambient = origAmbient
    Lighting.Brightness = origBrightness
    Lighting.GlobalShadows = origGlobalShadows
    Lighting.FogEnd = origFogEnd
end)

track(RunService.Heartbeat:Connect(function()
    if State.Fullbright then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 2.2
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and State.SpeedEnabled then
        hum.WalkSpeed = State.WalkSpeed
    end

    local staminaVal = 100
    if char then
        for _, v in ipairs(char:GetDescendants()) do
            if (v:IsA("NumberValue") or v:IsA("IntValue")) and string.lower(v.Name):find("stamina") then
                if not string.lower(v.Name):find("max") then
                    staminaVal = math.clamp(math.floor(v.Value), 0, 100)
                end
            end
        end
    end
    energyValLbl.Text = string.format("%s: %d%%", LocalPlayer.Name, staminaVal)
end))

task.spawn(function()
    while env.ZenxhubDemonologyCleanup do
        local found = {
            handprints = false,
            spirit = false,
            orb = false,
            writing = false,
            laser = false,
            wither = false,
            emf = 0,
            temp = 0,
            favRoom = "...",
            curRoom = "...",
        }

        for _, obj in ipairs(Workspace:GetDescendants()) do
            local n = string.lower(obj.Name)
            if n:find("handprint") or n:find("fingerprint") then
                found.handprints = true
            elseif n:find("orb") then
                found.orb = true
            elseif n:find("writing") or n:find("ghostbook") or n:find("book") then
                found.writing = true
            elseif n:find("laser") or n:find("projector") or n:find("dots") then
                found.laser = true
            elseif n:find("wither") or n:find("salt") or n:find("bone") then
                found.wither = true
            elseif n:find("emf") then
                local lvl = tonumber(obj.Name:match("%d+")) or obj:GetAttribute("EMF") or 0
                if type(lvl) == "number" and lvl > found.emf then
                    found.emf = math.clamp(lvl, 0, 5)
                end
            end
        end

        local ghost = findGhostModel()
        if ghost then
            local fav = ghost:GetAttribute("FavoriteRoom") or ghost:GetAttribute("GhostRoom") or ghost:GetAttribute("Room")
            local cur = ghost:GetAttribute("CurrentRoom") or ghost:GetAttribute("Room")
            if type(fav) == "string" and fav ~= "" then found.favRoom = fav end
            if type(cur) == "string" and cur ~= "" then found.curRoom = cur end
            local gTemp = ghost:GetAttribute("Temperature") or ghost:GetAttribute("Temp")
            if type(gTemp) == "number" then found.temp = math.floor(gTemp) end
        end

        local function setEv(lbl, prefix, isYes)
            lbl.Text = prefix .. (isYes and "Yes" or "No")
            lbl.TextColor3 = isYes and Theme.Green or Theme.Red
        end

        setEv(evHandprints, "Handprints: ", found.handprints)
        setEv(evSpiritBox, "Spirit Box: ", found.spirit)
        setEv(evGhostOrb, "Ghost Orb: ", found.orb)
        setEv(evWriting, "Ghost Writing: ", found.writing)
        setEv(evLaser, "Laser Projector: ", found.laser)
        setEv(evWither, "Wither: ", found.wither)

        evEmf.Text = "EMF level: " .. tostring(found.emf)
        evEmf.TextColor3 = found.emf >= 5 and Theme.Green or (found.emf > 0 and Theme.Yellow or Theme.Red)

        evTemp.Text = "Temperature: " .. tostring(found.temp) .. "C"
        evTemp.TextColor3 = found.temp <= 0 and Theme.Cyan or Theme.Yellow

        ghostMetaLbl.Text = string.format("Ghost: Unknown | Age ?? | Favorite room: %s", found.favRoom)
        currentRoomLbl.Text = string.format("Current room: %s", found.curRoom)

        if State.AutoSpirit then
            pcall(function()
                for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
                    if rem:IsA("RemoteEvent") and string.lower(rem.Name):find("spirit") then
                        rem:FireServer("Hello")
                    end
                end
            end)
        end

        if State.GhostEsp then
            rebuildCategoryEsp("ghost", function(o)
                return o:IsA("Model") and o ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(o)
                    and (string.lower(o.Name):find("ghost") or string.lower(o.Name):find("demon") or string.lower(o.Name):find("spirit") or o:GetAttribute("IsGhost") == true)
            end, function() return Theme.Red end, function(o, d)
                return string.format("👻 %s [%dm]", o.Name, d)
            end)
        end

        if State.ItemEsp then
            rebuildCategoryEsp("item", function(o)
                if not (o:IsA("BasePart") or o:IsA("Model") or o:IsA("Tool")) then return false end
                local n = string.lower(o.Name)
                return n:find("flashlight") or n:find("camera") or n:find("therm") or n:find("emf") or n:find("book") or n:find("spirit") or n:find("lighter") or n:find("crucifix") or n:find("salt")
            end, function() return Theme.Yellow end, function(o, d)
                return string.format("📦 %s [%dm]", o.Name, d)
            end)
        end

        if State.PlayersEsp then
            rebuildCategoryEsp("player", function(o)
                if not o:IsA("Model") or o == LocalPlayer.Character then return false end
                return Players:GetPlayerFromCharacter(o) ~= nil
            end, function() return Theme.Green end, function(o, d)
                return string.format("👤 %s [%dm]", o.Name, d)
            end)
        end

        if State.EvidenceEsp then
            rebuildCategoryEsp("evidence", function(o)
                local n = string.lower(o.Name)
                return n:find("handprint") or n:find("fingerprint") or n:find("orb") or n:find("writing") or n:find("bone")
            end, function() return Theme.Cyan end, function(o, d)
                return string.format("🔍 %s [%dm]", o.Name, d)
            end)
        end

        task.wait(0.8)
    end
end)
