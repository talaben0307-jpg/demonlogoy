makeActionBtn(Page1, "Hunt escape", 0.25, 0, 188, 0.23, -4, 30, function(_, btn)
    local char = LocalPlayer.Character
    local hrp = getHRP(char)
    local ghost = findGhostModel()
    local gHrp = getHRP(ghost)
    if hrp and gHrp then
        local awayDir = hrp.Position - gHrp.Position
        awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
        if awayDir.Magnitude < 0.1 then awayDir = Vector3.new(0, 0, -1) else awayDir = awayDir.Unit end
        hrp.CFrame = CFrame.new(hrp.Position + awayDir * 45 + Vector3.new(0, 2, 0))
    elseif hrp then
        hrp.CFrame = hrp.CFrame + Vector3.new(0, 12, 0)
    end
    btn.BackgroundColor3 = Theme.Cyan
    task.delay(0.25, function() if btn.Parent then btn.BackgroundColor3 = Color3.new(1, 1, 1) end end)
    return "nottoggle"
end)

makeActionBtn(Page1, "Place stuffs near ghost", 0.5, 0, 188, 0.23, -4, 30, function(_, btn)
    local char = LocalPlayer.Character
    local ghost = findGhostModel()
    local gHrp = getHRP(ghost)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if char and gHrp and bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local n = string.lower(tool.Name)
                if n:find("emf") or n:find("book") or n:find("write") or n:find("projector") or n:find("dots") or n:find("therm") or n:find("spirit") then
                    tool.Parent = char
                    pcall(function()
                        if tool:FindFirstChild("Handle") then
                            tool.Handle.CFrame = gHrp.CFrame * CFrame.new(0, 0, -3)
                        end
                    end)
                end
            end
        end
    end
    btn.BackgroundColor3 = Theme.Cyan
    task.delay(0.25, function() if btn.Parent then btn.BackgroundColor3 = Color3.new(1, 1, 1) end end)
    return "nottoggle"
end)

makeActionBtn(Page1, "Check speed: 1s", 0.75, 0, 188, 0.25, 0, 30, function(_, btn)
    local ghost = findGhostModel()
    local gHrp = getHRP(ghost)
    if not gHrp then
        btn.Text = "No ghost"
        task.delay(1, function() if btn.Parent then btn.Text = "Check speed: 1s" end end)
        return "nottoggle"
    end
    local p1 = gHrp.Position
    task.wait(1)
    local p2 = gHrp.Position
    local spd = math.floor((p2 - p1).Magnitude * 10) / 10
    btn.Text = "Spd: " .. tostring(spd)
    task.delay(2, function() if btn.Parent then btn.Text = "Check speed: 1s" end end)
    return "nottoggle"
end)

makeActionBtn(Page1, "Turn on fuse", 0, 0, 226, 0.23, -4, 30, function(_, btn)
    local char = LocalPlayer.Character
    local hrp = getHRP(char)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local n = string.lower(obj.Name)
        if n:find("fuse") or n:find("breaker") or n:find("powerbox") then
            local prompt = obj:IsA("ProximityPrompt") and obj or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            local click = obj:IsA("ClickDetector") and obj or obj:FindFirstChildWhichIsA("ClickDetector", true)
            local targetPart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if hrp and targetPart then
                hrp.CFrame = targetPart.CFrame * CFrame.new(0, 0, 3)
            end
            if prompt and fireproximityprompt then pcall(fireproximityprompt, prompt) end
            if click and fireclickdetector then pcall(fireclickdetector, click) end
        end
    end
    btn.BackgroundColor3 = Theme.Cyan
    task.delay(0.25, function() if btn.Parent then btn.BackgroundColor3 = Color3.new(1, 1, 1) end end)
    return "nottoggle"
end)

